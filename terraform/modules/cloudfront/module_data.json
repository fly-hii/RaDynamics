      "distribution_arn",
      "distribution_domain_name",
      "distribution_status"
    ],
    "security": [
      "security_controls_validation",
      "security_config",
      "origin_access_control_id"
    ],
    "monitoring": [
      "monitoring_config",
      "origin_latency_alarm_arn",
      "error_rate_alarm_arn"
    ],
    "compliance": [
      "ccms_compliance",
      "tags_applied"
    ]
  },
  "dependencies": {
    "aws_services": [
      "CloudFront",
      "S3 (for origins and logging)",
      "ACM (for SSL certificates)",
      "WAF (optional)",
      "CloudWatch (for monitoring)",
      "Lambda (for Lambda@Edge)"
    ],
    "terraform_providers": [
      "hashicorp/aws ~> 5.0",
      "hashicorp/null ~> 3.0"
    ]
  },
