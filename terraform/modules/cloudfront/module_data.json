{
  "name": "CloudFront Distribution",
  "version": "1.0.0",
  "description": "Comprehensive AWS CloudFront distribution module with security controls, monitoring, and CCMS compliance",
  "provider": "aws",
  "provider_version": "~> 5.0",
  "terraform_version": ">= 1.0",
  "module_metadata": {
    "category": "Content Delivery Network",
    "subcategory": "CloudFront",
    "complexity": "advanced",
    "maintenance_level": "high",
    "security_level": "enterprise",
    "compliance": ["CCMS", "SOC2", "PCI-DSS"],
    "last_updated": "2024-01-15",
    "author": "IndraSuite Infrastructure Team"
  },
  "security_controls": {
    "CF-01": {
      "name": "HTTPS Enforcement",
      "description": "Enforces HTTPS for all viewer requests",
      "implementation": "viewer_protocol_policy configuration",
      "validation": "Automated validation in main.tf"
    },
    "CF-02": {
      "name": "Origin Security",
      "description": "Secures communication between CloudFront and origins",
      "implementation": "Origin Access Control and custom origin HTTPS",
      "validation": "Origin protocol policy validation"
    },
    "CF-03": {
      "name": "Security Headers",
      "description": "Implements security headers for enhanced protection",
      "implementation": "Response Headers Policy with HSTS, CSP, etc.",
      "validation": "Security headers policy validation"
    },
    "CF-04": {
      "name": "Geographic Access Control",
      "description": "Controls access based on geographic location",
      "implementation": "Geo-restriction configuration",
      "validation": "Geographic restriction validation"
    },
    "CF-05": {
      "name": "Access Logging",
      "description": "Enables comprehensive access logging",
      "implementation": "CloudFront access logs to S3",
      "validation": "Logging configuration validation"
    }
  },
  "features": {
    "core_features": [
      "CloudFront Distribution",
      "Origin Access Control (OAC)",
      "Multiple Origins Support",
      "Cache Behaviors Configuration",
      "Custom Error Pages",
      "SSL/TLS Configuration",
      "Geographic Restrictions"
    ],
    "security_features": [
      "HTTPS Enforcement",
      "Security Headers Policy",
      "WAF Integration",
      "Origin Access Control",
      "Custom Security Headers",
      "CORS Configuration",
      "Security Controls Validation"
    ],
    "monitoring_features": [
      "CloudWatch Alarms",
      "Origin Latency Monitoring",
      "Error Rate Monitoring",
      "Access Logging",
      "Real-time Logs Support"
    ],
    "advanced_features": [
      "Lambda@Edge Support",
      "CloudFront Functions",
      "Field-Level Encryption",
      "Origin Shield",
      "Custom Cache Policies",
      "Response Headers Policies"
    ]
  },
  "use_cases": [
    {
      "name": "Static Website Hosting",
      "description": "Serve static websites with S3 origin",
      "complexity": "basic",
      "example": "Single S3 origin with OAC"
    },
    {
      "name": "API Acceleration",
      "description": "Accelerate API responses with custom origins",
      "complexity": "intermediate",
      "example": "ALB origin with custom cache behaviors"
    },
    {
      "name": "Multi-Origin Distribution",
      "description": "Complex distributions with multiple origins",
      "complexity": "advanced",
      "example": "S3 + ALB origins with path-based routing"
    },
    {
      "name": "Enterprise Security",
      "description": "High-security distributions with all controls",
      "complexity": "enterprise",
      "example": "Full security controls, WAF, monitoring"
    }
  ],
  "configuration_examples": {
    "basic_s3_website": {
      "description": "Basic S3 website with HTTPS redirect",
      "required_variables": [
        "distribution_name",
        "environment",
        "project_name",
        "owner",
        "cost_center",
        "business_unit",
        "application_name"
      ],
      "optional_features": [
        "create_origin_access_control",
        "enable_security_headers"
      ]
    },
    "api_acceleration": {
      "description": "API acceleration with custom origin",
      "required_variables": [
        "distribution_name",
        "origins",
        "default_cache_behavior"
      ],
      "recommended_features": [
        "enable_cloudwatch_alarms",
        "enable_logging",
        "web_acl_id"
      ]
    },
    "enterprise_security": {
      "description": "Full security implementation",
      "required_variables": [
        "distribution_name",
        "security_controls_enabled",
        "enable_security_headers",
        "enable_logging",
        "enable_cloudwatch_alarms"
      ],
      "security_features": [
        "viewer_protocol_policy: redirect-to-https",
        "web_acl_id",
        "geo_restriction",
        "security_headers"
      ]
    }
  },
  "input_variables": {
    "required": [
      "distribution_name",
      "environment",
      "project_name",
      "owner",
      "cost_center",
      "business_unit",
      "application_name",
      "origins",
      "default_cache_behavior"
    ],
    "optional_basic": [
      "comment",
      "enabled",
      "price_class",
      "aliases",
      "default_root_object"
    ],
    "optional_security": [
      "viewer_protocol_policy",
      "web_acl_id",
      "geo_restriction",
      "enable_security_headers",
      "security_headers",
      "cors_config"
    ],
    "optional_monitoring": [
      "enable_logging",
      "logging_config",
      "enable_cloudwatch_alarms",
      "origin_latency_threshold",
      "error_rate_threshold"
    ],
    "optional_advanced": [
      "ordered_cache_behaviors",
      "custom_error_responses",
      "create_origin_access_control",
      "custom_headers"
    ]
  },
  "outputs": {
