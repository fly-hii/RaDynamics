{
  "module_info": {
    "name": "terraform-aws-s3-module",
    "version": "1.0.0",
    "description": "AWS S3 L1 Module with comprehensive security controls and CCMS compliance",
    "provider": "aws",
    "service": "s3",
    "tier": "L1",
    "compliance": "CCMS"
  },
  "security_controls": {
    "implemented": [
      "S3-01", "S3-02", "S3-03", "S3-04", "S3-05", 
      "S3-06", "S3-07", "S3-08"
    ],
    "total_count": 8,
    "compliance_frameworks": ["NIST", "ISO27001", "SOC2", "PCI-DSS", "GDPR"]
  },
  "ccms_config": {
    "tag_chaining": true,
    "l1_module": true,
    "security_validation": true,
    "compliance_reporting": true
  },
  "features": {
    "server_side_encryption": true,
    "object_versioning": true,
    "public_access_block": true,
    "ssl_only_access": true,
    "access_logging": true,
    "lifecycle_management": true,
    "object_lock": true,
    "cloudwatch_monitoring": true,
    "cors_configuration": true,
    "website_hosting": true,
    "transfer_acceleration": true,
    "intelligent_tiering": true,
    "notification_configuration": true
  },
  "supported_configurations": {
    "encryption_types": ["AES256", "aws:kms"],
    "storage_classes": [
      "STANDARD", "REDUCED_REDUNDANCY", "STANDARD_IA", 
      "ONEZONE_IA", "INTELLIGENT_TIERING", "GLACIER", 
      "DEEP_ARCHIVE", "GLACIER_IR"
    ],
    "object_lock_modes": ["GOVERNANCE", "COMPLIANCE"],
    "notification_types": ["lambda", "sns", "sqs"]
  },
  "cost_optimization": {
    "lifecycle_transitions": true,
    "intelligent_tiering": true,
    "multipart_cleanup": true,
    "version_management": true
  },
  "monitoring": {
    "cloudwatch_integration": true,
    "access_logging": true,
    "security_alarms": true,
    "metric_filters": true
  }
}