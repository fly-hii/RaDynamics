{
  "module_info": {
    "name": "terraform-aws-ec2-module",
    "version": "1.0.0",
    "description": "AWS EC2 L1 Module with comprehensive security controls and CCMS compliance",
    "provider": "aws",
    "service": "ec2",
    "tier": "L1",
    "compliance": "CCMS"
  },
  "security_controls": {
    "implemented": [
      "EC2-01", "EC2-02", "EC2-05", "EC2-06", "EC2-07", 
      "EC2-09", "EC2-15", "EC2-16", "EC2-17", "EC2-18", "EC2-19"
    ],
    "total_count": 19,
    "compliance_frameworks": ["NIST", "ISO27001", "SOC2", "PCI-DSS"]
  },
  "ccms_config": {
    "tag_chaining": true,
    "l1_module": true,
    "security_validation": true,
    "compliance_reporting": true
  },
  "features": {
    "user_data_templates": true,
    "cloudwatch_integration": true,
    "security_monitoring": true,
    "encryption_at_rest": true,
    "imdsv2_enforcement": true,
    "network_isolation": true
  }
}