{
  "name": "Application Load Balancer",
  "description": "AWS Application Load Balancer with Target Groups and Listeners",
  "version": "1.0.0",
  "provider": "aws",
  "category": "networking",
  "tags": ["alb", "load-balancer", "networking", "target-group"],
  "resources": [
    "aws_lb",
    "aws_lb_target_group", 
    "aws_lb_listener",
    "aws_lb_listener_rule",
    "aws_lb_target_group_attachment"
  ],
  "estimated_cost": {
    "monthly_base": 16.20,
    "currency": "USD",
    "notes": "Base cost for ALB + data processing charges"
  },
  "deployment_time": {
    "estimated_minutes": 5,
    "factors": ["target_group_count", "listener_rules_count"]
  },
  "prerequisites": [
    "VPC with subnets in multiple AZs",
    "Security groups configured",
    "SSL certificate (for HTTPS)"
  ],
  "use_cases": [
    "Web application load balancing",
    "Microservices routing",
    "SSL termination",
    "Path-based routing",
    "Host-based routing"
  ],
  "limitations": [
    "Requires at least 2 subnets in different AZs",
    "Maximum 100 target groups per ALB",
    "Maximum 100 rules per listener"
  ]
}